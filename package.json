{
  "name": "rakuten-csv-extension",
  "private": true,
  "version": "2.0.58",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs",
